---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import InterviewMode from '../components/interview/InterviewMode.tsx';
import type { InterviewQuestion } from '../components/interview/InterviewMode.tsx';
import { getItems, getStats } from '../lib/content';

const stats = getStats();

const questions: InterviewQuestion[] = getItems()
  .filter((item) => item.type === 'question' || item.type === 'concept')
  .map((item) => ({
    id: item.id,
    href: item.href,
    prompt: item.title,
    answer: item.type === 'question' ? item.shortAnswer : item.definition,
    kind: item.type === 'question' ? ('question' as const) : ('concept' as const),
    categoryId: item.category,
    categoryName: item.categoryShortName,
    accent: item.accent,
    difficulty: item.difficulty,
    followUps: item.type === 'question' ? item.followUps : undefined,
  }));
---

<BaseLayout
  title="Interview Mode"
  description="Practice interview questions one at a time: answer out loud, reveal the model answer, then track what you missed."
>
  <div class="container-page py-12 sm:py-16">
    <Breadcrumbs
      items={[{ name: 'Home', href: '/' }, { name: 'Interview Mode' }]}
    />

    <header class="mt-6 max-w-2xl">
      <p class="eyebrow">Practice</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Interview Mode
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-2">
        Answer out loud, reveal the model answer, then mark whether you knew it.
        Progress and weak topics are stored in this browser only. {questions.length}{' '}
        questions and concepts are available, drawn from {stats.categories}{' '}
        categories.
      </p>
    </header>

    <div class="mt-10 max-w-3xl">
      <InterviewMode client:load questions={questions} />
    </div>
  </div>
</BaseLayout>
