---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import { getLiveCategories, getRevisionCount, getRevisionEntries } from '../../lib/content';
import { collectionJsonLd } from '../../lib/seo';
import { getItems } from '../../lib/content';

const categories = getLiveCategories().map((category) => ({
  category,
  entries: getRevisionEntries(category.id),
}));

const total = getRevisionCount();

const jsonLd = collectionJsonLd({
  title: 'Quick Revision',
  description:
    'Skim a whole interview category in minutes with short, medium and detailed revision cards.',
  path: '/quick-revision',
  items: getItems(),
});
---

<BaseLayout
  title="Quick Revision"
  description="Skim a whole interview category in minutes with short, medium and detailed revision cards."
  jsonLd={jsonLd}
>
  <div class="container-page py-12 sm:py-16">
    <Breadcrumbs
      items={[{ name: 'Home', href: '/' }, { name: 'Quick Revision' }]}
    />

    <header class="mt-6">
      <p class="eyebrow">Before the interview</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Quick Revision
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-2">
        {total} revision cards across {categories.length} categories. Each card has
        three depths: a thirty-second line, a one-minute explanation and a
        detailed dive. Start shallow, go deeper only where you need it.
      </p>
    </header>

    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map(({ category, entries }) => (
          <li>
            <a
              href={`/quick-revision/${category.id}`}
              class="group flex h-full flex-col gap-3 rounded-lg border border-line bg-surface p-5 transition duration-150 ease-out hover:border-line-strong hover:shadow-sm"
            >
              <span class="flex items-center gap-2.5">
                <span
                  class="size-2.5 rounded-full"
                  style={`background:${category.accent}`}
                  aria-hidden="true"
                />
                <span class="font-medium tracking-tight text-ink">
                  {category.name}
                </span>
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="ml-auto shrink-0 text-ink-3 transition duration-150 ease-out group-hover:translate-x-0.5 group-hover:text-accent"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
              <span class="text-sm leading-relaxed text-ink-2">
                {category.description}
              </span>
              <span class="mt-auto font-mono text-[11px] tracking-wide text-ink-3">
                {entries.length} cards
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
