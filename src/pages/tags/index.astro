---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/site/Breadcrumbs.astro';
import { getAllTags } from '../../lib/content';

const tags = getAllTags();
---

<BaseLayout
  title="Tags"
  description="Browse every topic in the knowledge base by tag, from closures and scope to hydration and Core Web Vitals."
>
  <div class="container-page py-12 sm:py-16">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Tags' }]} />

    <header class="mt-6 max-w-2xl">
      <p class="eyebrow">Discovery</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        Tags
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-2">
        {tags.length} tags across the knowledge base. Follow a tag to see every
        topic that touches it.
      </p>
    </header>

    <ul class="mt-10 flex flex-wrap gap-2">
      {
        tags.map(({ tag, count }) => (
          <li>
            <a
              href={`/tags/${tag}`}
              class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm text-ink-2 transition duration-150 ease-out hover:border-line-strong hover:text-ink"
            >
              <span class="font-mono text-[13px]">{tag}</span>
              <span
                class="font-mono text-[11px] text-ink-3"
                aria-label={`${count} topics`}
              >
                {count}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
