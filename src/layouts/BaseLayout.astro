---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import SearchDialog from '../components/search/SearchDialog.tsx';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  home?: boolean;
  keywords?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  ogType = 'website',
  noindex = false,
  home = false,
  keywords,
  jsonLd,
} = Astro.props;

const pageTitle = home ? SITE.title ?? `${SITE.name} - developer interview knowledge base` : title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const keywordList = keywords
  ? `${keywords}, ${SITE.keywords.join(', ')}`
  : SITE.keywords.join(', ');
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={SITE.locale} class="scroll-pt-20">
  <head>
    <meta charset="UTF-8" />
    <script is:inline data-astro-rerun>
      (() => {
        try {
          const stored = localStorage.getItem('prepbase-theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <ClientRouter />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywordList} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {
      import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      import.meta.env.PUBLIC_BING_SITE_VERIFICATION && (
        <meta
          name="msvalidate.01"
          content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION}
        />
      )
    }
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0f0f4" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17171b" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body class="min-h-dvh antialiased">
    <div
      data-nav-progress
      transition:persist="nav-progress"
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-0 z-[200] h-[2px] origin-left bg-accent"
    >
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-accent-ink"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchDialog client:idle />

    <script is:inline>
      (() => {
        if (window.__prepbaseCopy) return;
        window.__prepbaseCopy = true;

        // Delegated so it works for code blocks on any page, including pages
        // reached by client-side navigation where inline scripts do not re-run.
        document.addEventListener('click', async (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest('[data-copy]');
          if (!button) return;

          const frame = button.closest('[data-code]');
          const code = frame?.querySelector('pre code')?.textContent ?? '';

          try {
            await navigator.clipboard.writeText(code);
          } catch {}

          const label = button.querySelector('span');
          if (!label) return;
          const previous = label.textContent;
          label.textContent = 'Copied';
          button.dataset.state = 'copied';
          clearTimeout(button.__copyTimer);
          button.__copyTimer = setTimeout(() => {
            label.textContent = previous;
            delete button.dataset.state;
          }, 1400);
        });
      })();
    </script>

    <script is:inline>
      (() => {
        if (window.__prepbaseNavProgress) return;
        window.__prepbaseNavProgress = true;

        let timer;

        const start = () => {
          const bar = document.querySelector('[data-nav-progress]');
          if (!bar) return;
          clearTimeout(timer);
          bar.dataset.active = 'true';
          bar.style.transform = 'scaleX(0.08)';
          requestAnimationFrame(() => {
            bar.style.transform = 'scaleX(0.75)';
          });
          timer = setTimeout(() => {
            bar.style.transform = 'scaleX(0.9)';
          }, 400);
        };

        const done = () => {
          const bar = document.querySelector('[data-nav-progress]');
          if (!bar) return;
          clearTimeout(timer);
          bar.style.transform = 'scaleX(1)';
          setTimeout(() => {
            bar.dataset.active = 'false';
            bar.style.transform = 'scaleX(0)';
          }, 180);
        };

        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:page-load', done);
      })();
    </script>

    <script is:inline>
      (() => {
        if (window.__prepbaseRevealBound) return;
        window.__prepbaseRevealBound = true;

        const run = () => {
          const targets = document.querySelectorAll('[data-reveal]');
          if (!targets.length) return;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          const viewport = window.innerHeight;
          const pending = new Set();

          targets.forEach((el) => {
            // Anything already on screen is left alone: no first-paint or LCP cost.
            if (el.getBoundingClientRect().top < viewport * 0.9) return;
            el.setAttribute('data-reveal-hidden', '');
            pending.add(el);
          });

          if (!pending.size) return;

          let ticking = false;

          const reveal = () => {
            ticking = false;
            const limit = window.innerHeight * 0.9;
            for (const el of pending) {
              if (el.getBoundingClientRect().top >= limit) continue;
              el.removeAttribute('data-reveal-hidden');
              pending.delete(el);
            }
            if (!pending.size) {
              window.removeEventListener('scroll', onScroll);
              window.removeEventListener('resize', onScroll);
            }
          };

          const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(reveal);
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
          reveal();
        };

        // First paint is handled immediately; later navigations fire page-load.
        let first = true;
        document.addEventListener('astro:page-load', () => {
          if (first) {
            first = false;
            return;
          }
          run();
        });
        run();
      })();
    </script>
  </body>
</html>
