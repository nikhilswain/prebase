---
import type { ResolvedItem } from '../../lib/content-types';
import { getTypeLabel } from '../../lib/content';

interface Props {
  items: ResolvedItem[];
  title?: string;
  description?: string;
  class?: string;
}

const { items, title = 'Related', description, class: className } = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['scroll-mt-24', className]} aria-labelledby="related-heading">
      <h2 id="related-heading" class="eyebrow">
        {title}
      </h2>
      {description && (
        <p class="mt-2 text-sm leading-relaxed text-ink-2">{description}</p>
      )}
      <ul class="mt-3 divide-y divide-line border-y border-line">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex items-center gap-3 py-2.5 transition-colors hover:text-accent"
            >
              <span class="min-w-0 flex-1">
                <span class="block truncate text-[15px] font-medium tracking-tight text-ink transition-colors group-hover:text-accent">
                  {item.title}
                </span>
                <span class="mt-0.5 block truncate font-mono text-[11px] tracking-wide text-ink-3 uppercase">
                  {getTypeLabel(item.type)} · {item.categoryShortName}
                </span>
              </span>
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="shrink-0 text-ink-3 transition duration-150 ease-out group-hover:text-accent hover-media:group-hover:translate-x-0.5"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
