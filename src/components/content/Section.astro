---
interface Props {
  label: string;
  id?: string;
  description?: string;
  tone?: 'default' | 'muted';
  class?: string;
}

const { label, id, description, tone = 'default', class: className } = Astro.props;
---

<section class:list={['scroll-mt-24', className]} aria-labelledby={id}>
  <h2
    id={id}
    class:list={[
      'eyebrow',
      tone === 'muted' && 'text-ink-3/80',
    ]}
  >
    {label}
  </h2>
  {
    description && (
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-3">{description}</p>
    )
  }
  <div class="mt-3">
    <slot />
  </div>
</section>
