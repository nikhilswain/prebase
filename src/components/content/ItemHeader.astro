---
import type { ResolvedItem } from '../../lib/content-types';
import { getTypeLabel } from '../../lib/content';
import DifficultyBadge from '../ui/DifficultyBadge.astro';

interface Props {
  item: ResolvedItem;
}

const { item } = Astro.props;
---

<header>
  <p class="flex flex-wrap items-center gap-2 text-[11px] font-medium tracking-wide text-ink-3 uppercase">
    <span
      class="size-1.5 rounded-full"
      style={`background:${item.accent}`}
      aria-hidden="true"
    />
    <a href={`/${item.category}`} class="font-mono transition-colors hover:text-ink">
      {item.categoryName}
    </a>
    <span aria-hidden="true">·</span>
    <span class="font-mono">{getTypeLabel(item.type)}</span>
  </p>

  <h1
    class="mt-3 text-3xl leading-[1.15] font-semibold tracking-tight text-balance sm:text-4xl"
  >
    {item.title}
  </h1>

  <p class="mt-3.5 max-w-2xl text-base leading-relaxed text-ink-2">
    {item.summary}
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2.5">
    <DifficultyBadge difficulty={item.difficulty} />
    {
      item.tags && item.tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {item.tags.map((tag) => (
            <li>
              <a
                href={`/tags/${tag}`}
                class="inline-block rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[11px] text-ink-3 transition-colors hover:border-line-strong hover:text-ink-2"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</header>
