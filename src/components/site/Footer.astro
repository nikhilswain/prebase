---
import { FOOTER_GROUPS, SITE } from '../../config';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="text-[15px] font-semibold tracking-tight">
          <span>prep</span><span class="text-ink-2">base</span>
        </p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-2">
          A fast, structured developer interview knowledge base. Search a
          topic, understand it, revise it, move on.
        </p>
        <a
          href="/contribute"
          class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-opacity hover:opacity-80"
        >
          Contribute a topic
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>

      {
        FOOTER_GROUPS.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="eyebrow">{group.title}</h2>
            <ul class="mt-4 space-y-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-2 transition-colors hover:text-ink"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {SITE.domain}. Content is community-maintained.</p>
      <p class="font-mono">
        Built with Astro · Static, fast, and open
      </p>
    </div>
  </div>
</footer>
