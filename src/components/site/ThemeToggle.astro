---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  aria-pressed="false"
  title="Toggle theme"
  class:list={[
    'grid size-9 place-items-center rounded-md text-ink-2 transition-colors duration-150 ease-out hover:bg-surface-2 hover:text-ink active:scale-95',
    className,
  ]}
>
  <span class="relative grid size-[17px] place-items-center" aria-hidden="true">
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="col-start-1 row-start-1 rotate-45 opacity-0 transition duration-200 ease-out dark:rotate-0 dark:opacity-100"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      ></path>
    </svg>
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="col-start-1 row-start-1 rotate-0 opacity-100 transition duration-200 ease-out dark:-rotate-45 dark:opacity-0"
    >
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
  </span>
</button>

<script is:inline>
  (() => {
    if (window.__prepbaseThemeToggle) return;
    window.__prepbaseThemeToggle = true;

    const sync = () => {
      const dark = document.documentElement.classList.contains('dark');
      document
        .querySelectorAll('[data-theme-toggle]')
        .forEach((el) => el.setAttribute('aria-pressed', String(dark)));
    };

    const bind = () => {
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('prepbase-theme', dark ? 'dark' : 'light');
          } catch {}
          sync();
        });
      });
      sync();
    };

    // Inline scripts run once; page-load fires on first paint and every swap.
    document.addEventListener('astro:page-load', bind);
    bind();
  })();
</script>
