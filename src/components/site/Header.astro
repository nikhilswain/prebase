---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger.astro';
import { NAV } from '../../config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur-md"
>
  <div class="container-page flex h-14 items-center gap-3">
    <Logo />

    <nav class="ml-3 hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors duration-150 ease-out',
              isActive(item.href)
                ? 'bg-surface-2 font-medium text-ink'
                : 'text-ink-2 hover:bg-surface-2 hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <SearchTrigger />
      <ThemeToggle />
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open navigation menu"
        class="grid size-9 place-items-center rounded-md text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink md:hidden"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    data-open="false"
    inert
    class="grid grid-rows-[0fr] overflow-hidden border-t border-line bg-canvas opacity-0 transition-[grid-template-rows,opacity] duration-200 ease-out data-[open=true]:grid-rows-[1fr] data-[open=true]:opacity-100 md:hidden"
  >
    <div class="min-h-0 overflow-hidden">
      <nav class="container-page flex flex-col py-2" aria-label="Primary mobile">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-2.5 text-[15px] transition-colors',
                isActive(item.href)
                  ? 'bg-surface-2 font-medium text-ink'
                  : 'text-ink-2 hover:bg-surface-2 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    if (window.__prepbaseHeader) return;
    window.__prepbaseHeader = true;

    const setOpen = (open) => {
      const toggle = document.querySelector('[data-menu-toggle]');
      const panel = document.getElementById('mobile-nav');
      if (!toggle || !panel) return;
      panel.dataset.open = String(open);
      panel.toggleAttribute('inert', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? 'Close navigation menu' : 'Open navigation menu',
      );
    };

    const close = (refocus) => {
      const panel = document.getElementById('mobile-nav');
      if (!panel || panel.dataset.open !== 'true') return;
      setOpen(false);
      if (refocus) document.querySelector('[data-menu-toggle]')?.focus();
    };

    const bind = () => {
      const toggle = document.querySelector('[data-menu-toggle]');
      if (!toggle || toggle.dataset.bound === 'true') return;
      toggle.dataset.bound = 'true';
      toggle.addEventListener('click', () => {
        const panel = document.getElementById('mobile-nav');
        setOpen(panel ? panel.dataset.open !== 'true' : false);
      });
    };

    // Inline scripts run once; page-load fires on first paint and every swap.
    document.addEventListener('astro:page-load', bind);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close(true);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) close(false);
    });

    bind();
  })();
</script>
