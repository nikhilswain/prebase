---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../site/Breadcrumbs.astro';
import TopicFilter from './TopicFilter.tsx';
import { toLiteItems } from '../../lib/content';
import type { ResolvedItem } from '../../lib/content-types';

interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  crumbs: Crumb[];
  items: ResolvedItem[];
  jsonLd?: Record<string, unknown>;
  placeholder?: string;
  emptyLabel?: string;
  noindex?: boolean;
}

const {
  eyebrow,
  title,
  description,
  crumbs,
  items,
  jsonLd,
  placeholder,
  emptyLabel,
  noindex = false,
} = Astro.props;

const lite = toLiteItems(items);
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  noindex={noindex}
>
  <div class="container-page py-10 sm:py-12">
    <Breadcrumbs items={crumbs} />

    <header class="mt-6 max-w-2xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-ink-2">{description}</p>
    </header>

    <div class="mt-8">
      <TopicFilter
        client:load
        items={lite}
        placeholder={placeholder}
        emptyLabel={emptyLabel}
      />
    </div>

    <slot />
  </div>
</BaseLayout>
